# Groq (upstream LLM) — https://console.groq.com/keys
GROQ_API_KEY=

# Paritok (context compression) — https://paritok.com
PARITOK_API_KEY=

# Vercel KV (persistent store) — auto-filled when you create a KV store
# on Vercel; not needed for local dev (falls back to in-memory).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional overrides
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_INPUT_PRICE_PER_1M=0.59
# GROQ_OUTPUT_PRICE_PER_1M=0.79
# PARITOK_API_URL=https://www.paritok.com/api/compress
